{
	"name": "zias",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/node": "^22.13.14",
			"@cloudflare/workers-types": "^4.20251213.0",
			"hono": "^4.8.2",
			"@trpc/server": "^11.16.0",
			"better-auth": "1.6.11",
			"alchemy": "^0.91.2",
			"next-themes": "^0.4.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"@trpc/client": "^11.16.0",
			"@types/react": "^19.2.15",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @zias/db db:push",
		"db:generate": "turbo -F @zias/db db:generate",
		"db:seed": "turbo -F @zias/db db:seed",
		"deploy": "turbo -F @zias/infra deploy",
		"destroy": "turbo -F @zias/infra destroy",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@fontsource-variable/sora": "^5.2.8",
		"@zias/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@cloudflare/workers-types": "catalog:",
		"@zias/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.13"
}
