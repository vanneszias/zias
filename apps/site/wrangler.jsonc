{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zias-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "zias-site" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zias-media" }],
  // Astro sessions (EmDash admin login); provisioned on first deploy.
  "kv_namespaces": [{ "binding": "SESSION" }],
  // EmDash maintenance, scheduled publishing and plugin cron (forms cleanup).
  "triggers": { "crons": ["* * * * *"] },
}
