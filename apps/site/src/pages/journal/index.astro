---
import { getCategories, getPosts, postItem } from "@zias/blocks/journal";
import Lead from "@zias/ui/components/Lead.astro";
import List from "@zias/ui/components/List.astro";
import Base from "../../layouts/Base.astro";
import { staticOgUrl } from "../../lib/og";

const category = Astro.url.searchParams.get("category") ?? undefined;
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const [categories, { entries, nextCursor, cacheHint }] = await Promise.all([
  getCategories(),
  getPosts({ category, cursor }),
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const filter = categories.find((term) => term.slug === category);
const older =
  nextCursor &&
  `/journal?${new URLSearchParams({ ...(category && { category }), cursor: nextCursor })}`;
---

<Base
  title="Journal"
  description="Essays, case studies and notes on how websites and apps get made."
  image={staticOgUrl("/journal")}
  canonical={`${Astro.url.origin}/journal`}
>
  <Lead as="h1">Journal</Lead>
  {
    filter && (
      <p class="mt-3">
        <em>{filter.label}</em>,{" "}
        <a href="/journal" class="z-link">
          show everything
        </a>
      </p>
    )
  }
  {entries.length > 0 ? <List items={entries.map(postItem)} class="mt-12" /> : <p class="mt-12">Nothing here yet.</p>}
  {
    older && (
      <p class="mt-8">
        <a href={older} class="z-link">
          Older posts
        </a>
      </p>
    )
  }
</Base>
