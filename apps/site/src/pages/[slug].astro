---
import { decodeSlug } from "emdash";
import PageView from "../components/PageView.astro";
import { loadPage } from "../lib/pages";

const slug = decodeSlug(Astro.params.slug);
const loaded = slug ? await loadPage(slug, Astro.url.origin) : null;
if (!loaded) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(loaded.cacheHint);
---

<PageView loaded={loaded} />
