---
import ArrowLink from "@zias/ui/components/ArrowLink.astro";
import BigWord from "@zias/ui/components/BigWord.astro";
import Block from "@zias/ui/components/Block.astro";
import Scribble from "@zias/ui/components/Scribble.astro";
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Not found" robots="noindex">
  <Block tone="butter" pad="loose" class="overflow-hidden">
    <div class="relative inline-block">
      <BigWord as="h1" size="colossal">lost.</BigWord>
      <Scribble size="l" class="absolute right-0 bottom-0 translate-y-3/4">it happens</Scribble>
    </div>
    <p class="mt-space-5 mb-space-4 max-w-[24ch] text-statement max-sm:text-[1.75rem]">
      This page moved, or never was. The good stuff is one click away.
    </p>
    <ArrowLink href="/" size="big">home</ArrowLink>
  </Block>
</Base>
