---
// Rendered only when PUBLIC_OPENPANEL_CLIENT_ID is set, so no script ships without it.
---

<script>
  import { OpenPanel } from "@openpanel/web";
  import { PUBLIC_OPENPANEL_API_URL, PUBLIC_OPENPANEL_CLIENT_ID } from "astro:env/client";

  if (PUBLIC_OPENPANEL_CLIENT_ID) {
    new OpenPanel({
      apiUrl: PUBLIC_OPENPANEL_API_URL,
      clientId: PUBLIC_OPENPANEL_CLIENT_ID,
      trackScreenViews: true,
      trackOutgoingLinks: true,
      trackAttributes: true,
    });
  }
</script>
