---
import BigWord from "@zias/ui/components/BigWord.astro";
import Block from "@zias/ui/components/Block.astro";
import Tag from "@zias/ui/components/Tag.astro";
import type { MenuItem } from "emdash";

interface Props {
  items: MenuItem[];
}

const year = new Date().getFullYear();
---

<Block as="footer" tone="ink" pad="tight" class="overflow-hidden">
  <BigWord size="colossal" outline aria-hidden="true">zias</BigWord>
  <div class="mt-space-3 flex flex-wrap items-center justify-between gap-space-2">
    <Tag>© {year} Zias · Leuven, BE</Tag>
    <nav aria-label="Footer">
      <ul class="m-0 flex list-none flex-wrap gap-space-2 p-0">
        {Astro.props.items.map((item) => <li><Tag href={item.url}>{item.label}</Tag></li>)}
      </ul>
    </nav>
  </div>
</Block>
