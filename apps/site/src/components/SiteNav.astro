---
import Button from "@zias/ui/components/Button.astro";
import Logo from "@zias/ui/components/Logo.astro";
import NavBar from "@zias/ui/components/NavBar.astro";
import { MobileMenu } from "@zias/ui/react/mobile-menu";
import { ThemeToggle } from "@zias/ui/react/theme-toggle";
import type { MenuItem } from "emdash";

interface Props {
  items: MenuItem[];
}

const { pathname } = Astro.url;
const links = Astro.props.items.map((item) => ({
  label: item.label,
  href: item.url,
  active:
    !item.url.includes("#") &&
    item.url !== "/" &&
    pathname.startsWith(item.url),
}));
const action = { label: "Say hi", href: "/#contact" };
---

<div class="fixed inset-x-space-2 top-space-2 z-50">
  <NavBar note="studio" links={links} class="max-md:[&_.z-nav-links]:gap-space-1 max-md:[&_.z-nav-links>a.z-tag]:hidden max-sm:[&_.z-scribble]:hidden">
    <Logo slot="brand" height={28} />
    <Fragment slot="action">
      <ThemeToggle client:idle />
      <Button href={action.href} class="whitespace-nowrap">{action.label}</Button>
      <span class="md:hidden"><MobileMenu client:media="(max-width: 767px)" links={links} action={action} /></span>
    </Fragment>
  </NavBar>
</div>
