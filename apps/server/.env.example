# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3001

# Cloudflare D1 credentials (required for db:push / drizzle-kit)
# Find these in the Cloudflare dashboard → Workers & Pages → D1
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
CLOUDFLARE_DATABASE_ID=replace-with-your-d1-database-id
CLOUDFLARE_D1_TOKEN=replace-with-your-api-token

# Seed/admin helper vars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin

# Production examples
# BETTER_AUTH_URL=https://api.zias.be
# CORS_ORIGIN=https://zias.be,https://www.zias.be
