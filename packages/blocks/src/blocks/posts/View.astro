---
import List from "@zias/ui/components/List.astro";
import type { BlockProps } from "../../define";
import { getPosts, postItem } from "../../lib/journal";
import type { fields } from "./schema";

type Props = BlockProps<typeof fields>;
const { count, category, link_label } = Astro.props.value;

const { entries, cacheHint } = await getPosts({ limit: count, category });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const journal = category
  ? `/journal?category=${encodeURIComponent(category)}`
  : "/journal";
---

<section class="mt-auto pt-drop" aria-label="Writing">
  <List items={entries.map(postItem)} />
  {
    link_label && (
      <p class="mt-[0.9em]">
        <a href={journal} class="z-link">
          {link_label}
        </a>
      </p>
    )
  }
</section>
