---
/**
 * The forms plugin's form, drawn with the design system's Field and Button.
 * The plugin's client script submits it in place and fills the
 * `data-error-for` and `data-form-status` slots it looks for.
 */
import Button from "@zias/ui/components/Button.astro";
import Field from "@zias/ui/components/Field.astro";
import { loadForm } from "./definition";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const form = await loadForm(Astro.locals, Astro.url, slug);
---

{
  form && (
    <form
      method="POST"
      action="/_emdash/api/plugins/emdash-forms/submit"
      data-ec-form
      data-form-id={slug}
      data-submit-label={form.submitLabel}
      class="flex flex-col gap-space-4"
    >
      <fieldset data-page="0" class="m-0 grid min-w-0 gap-space-4 border-0 p-0 sm:grid-cols-2">
        {form.fields.map((field) => (
          <div class:list={[field.width === "full" && "sm:col-span-2"]}>
            <Field
              label={field.label}
              name={field.name}
              type={field.type === "textarea" ? undefined : field.type}
              multiline={field.type === "textarea"}
              rows={4}
              placeholder={field.placeholder}
              required={field.required}
              maxlength={field.validation?.maxLength}
              autocomplete={field.type === "email" ? "email" : field.name === "name" ? "name" : undefined}
            />
            <span class="z-field-note" data-error-for={field.name} aria-live="polite" />
          </div>
        ))}
      </fieldset>
      {form.honeypot && (
        <label class="absolute -left-[9999px]" aria-hidden="true">
          Leave blank
          <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
        </label>
      )}
      <input type="hidden" name="formId" value={slug} />
      <div class="flex flex-wrap items-center gap-space-3">
        <Button type="submit" size="l" class="ec-form-submit">
          {form.submitLabel}
        </Button>
        <p class="m-0 text-statement max-sm:text-[1.75rem]">
          <span data-form-status aria-live="polite" />
        </p>
      </div>
    </form>
  )
}

<script>
  import { initForms } from "@emdash-cms/plugin-forms/client";
  initForms();
</script>
