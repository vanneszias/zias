---
import { Image } from "emdash/ui";
import type { BlockProps } from "../../define";
import type { fields } from "./schema";

type Props = BlockProps<typeof fields>;
const { image, caption } = Astro.props.value;
---

<figure class="mt-drop first:mt-0">
  <Image image={image} class="block h-auto w-full" sizes="100vw" />
  {caption && <figcaption class="mt-3 italic">{caption}</figcaption>}
</figure>
