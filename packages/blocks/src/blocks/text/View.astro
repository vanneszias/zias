---
import Lead from "@zias/ui/components/Lead.astro";
import { PortableText } from "emdash/ui";
import type { BlockProps } from "../../define";
import type { fields } from "./schema";

type Props = BlockProps<typeof fields>;
const { value, index } = Astro.props;
const { title, note, body } = value;
---

<section class="mt-drop first:mt-0">
  {title && <Lead as={index === 0 ? "h1" : "h2"}>{title}</Lead>}
  {note && <p class="mt-3 italic">{note}</p>}
  <div class:list={["z-prose", (title || note) && "mt-12"]}>
    <PortableText value={body} />
  </div>
</section>
