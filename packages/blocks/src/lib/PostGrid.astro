---
import Card from "@zias/ui/components/Card.astro";
import { type Post, postCategory, postMeta } from "./journal";
import { cardTone, type Tone } from "./tone";

interface Props {
  posts: Post[];
  /** The block the grid sits on, so no card takes its colour. */
  ground?: Tone;
  class?: string;
}

const { posts, ground, class: className } = Astro.props;
---

<ul class:list={["m-0 grid list-none gap-space-3 p-0 sm:grid-cols-2 xl:grid-cols-4", className]}>
  {
    posts.map((post, i) => (
      <li class="flex">
        <Card
          href={`/journal/${post.id}`}
          title={post.data.title}
          tag={postCategory(post)?.label}
          meta={postMeta(post)}
          tone={cardTone(ground, i)}
        />
      </li>
    ))
  }
</ul>
