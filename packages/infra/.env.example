# Alchemy infra authentication
ALCHEMY_PASSWORD=replace-with-your-alchemy-password

# Web binding: frontend -> API base URL
VITE_SERVER_URL=https://api.zias.be

# Server bindings
CORS_ORIGIN=https://zias.be,https://www.zias.be
BETTER_AUTH_URL=https://api.zias.be

# Secret binding (set as secret in your deployment flow)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
