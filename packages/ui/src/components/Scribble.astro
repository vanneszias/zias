---
import type { HTMLAttributes } from "astro/types";
import { ink, mergeStyle } from "../lib/astro";

interface Props extends HTMLAttributes<"span"> {
  /** "s" 1.5rem, default 2.25rem, "l" 3.5rem. */
  size?: "s" | "l";
  color?: string;
  /** Degrees. Default -4. */
  rotate?: number;
}
const { size, color, rotate, class: className, style, ...rest } = Astro.props;
---

<span
  {...rest}
  class:list={["z-scribble", className]}
  data-size={size}
  style={mergeStyle(style, { color: ink(color), rotate: rotate === undefined ? undefined : `${rotate}deg` })}
><slot /></span>
