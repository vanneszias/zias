---
import type { HTMLAttributes } from "astro/types";
import type { Tone } from "../lib/astro";

interface Props extends HTMLAttributes<"section"> {
  /** Element to render. Default "section". */
  as?: keyof HTMLElementTagNameMap;
  /** Default "paper". */
  tone?: Tone;
  /** Vertical padding. Default space-5. */
  pad?: "none" | "tight" | "loose";
}
const { as: Tag = "section", tone = "paper", pad, class: className, ...rest } = Astro.props;
---

<Tag {...rest} class:list={["z-block", className]} data-tone={tone} data-pad={pad}><slot /></Tag>
