---
// Put in <head>. Sets data-theme on <html> before first paint.
---

<script is:inline>
  (function () {
    var t = null;
    try {
      t = localStorage.getItem("theme");
    } catch (e) {}
    if (t !== "light" && t !== "dark") {
      t = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    document.documentElement.dataset.theme = t;
  })();
</script>
