---
import type { HTMLAttributes } from "astro/types";
import type { LoudTone } from "../lib/astro";
import Arrow from "./Arrow.astro";
import Tag from "./Tag.astro";

interface Props extends HTMLAttributes<"a"> {
  title: string;
  /** Category, shown as a Tag on top. */
  tag?: string;
  /** Date and read time, shown as a Tag at the bottom. */
  meta?: string;
  /** Default: paper-bright. */
  tone?: LoudTone | "ink";
  href?: string;
}
const { title, tag, meta, tone, href, class: className, ...rest } = Astro.props;
const El = href ? "a" : "button";
const attrs = href ? { href } : { type: "button" };
---

<El {...rest} {...attrs} class:list={["z-card", className]} data-tone={tone}>
  <div class="z-card-top">
    {tag ? <Tag>{tag}</Tag> : <span />}
    <span class="z-card-arrow"><Arrow /></span>
  </div>
  <div>
    <h3 class="z-card-title">{title}</h3>
    <slot />
    {meta && <Tag>{meta}</Tag>}
  </div>
</El>
