---
import type { HTMLAttributes } from "astro/types";
import { ink, mergeStyle, type WordSize } from "../lib/astro";
import Arrow from "./Arrow.astro";
import BigWord from "./BigWord.astro";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  /** Default "huge". */
  size?: WordSize;
  /** Colour of the word. */
  color?: string;
  /** Colour of the arrow only. */
  accent?: string;
}
const {
  size = "huge",
  color,
  accent,
  class: className,
  style,
  ...rest
} = Astro.props;
---

<a {...rest} class:list={["z-arrowlink", className]} data-size={size} style={mergeStyle(style, { "--accent": ink(accent) })}>
  <BigWord size={size} color={color}><slot /></BigWord><Arrow />
</a>
