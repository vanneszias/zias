---
/** Rows of links: a title, and in italic what kind of thing it is. */
export interface Item {
  href: string;
  title: string;
  note?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={["grid max-w-wide gap-y-[0.9em] sm:gap-y-[0.35em]", className]}>
  {
    items.map((item) => (
      <li>
        <a href={item.href} class="group flex flex-col leading-[1.2] sm:flex-row sm:justify-between sm:gap-x-8">
          <span class="decoration-[0.06em] underline-offset-[0.2em] group-hover:underline">{item.title}</span>
          {item.note && <em class="sm:shrink-0">{item.note}</em>}
        </a>
      </li>
    ))
  }
</ul>
