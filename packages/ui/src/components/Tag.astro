---
import type { HTMLAttributes } from "astro/types";
import { flag } from "../lib/astro";
import Arrow from "./Arrow.astro";

interface Props extends HTMLAttributes<"a"> {
  /** Renders an underlined link. */
  href?: string;
  /** Adds the arrow. */
  arrow?: boolean;
  /** Underlines a current item. */
  active?: boolean;
}
const { href, arrow, active, class: className, ...rest } = Astro.props;
const El = href ? "a" : "span";
---

<El {...rest} href={href} class:list={["z-tag", className]} data-active={flag(active)}><slot />{arrow && <Arrow />}</El>
